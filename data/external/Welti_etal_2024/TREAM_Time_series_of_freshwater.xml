 IDed to genus level</attributeDefinition><measurementScale><ratio><unit><standardUnit>dimensionless</standardUnit></unit><numericDomain><numberType>real</numberType></numericDomain></ratio></measurementScale></attribute><attribute id="9CUTD8ZV4JTJCtml0mLGHcIaXlr0k9"><attributeName>EPT_SppRich</attributeName><attributeDefinition>number of EPT taxa</attributeDefinition><measurementScale><ratio><unit><standardUnit>dimensionless</standardUnit></unit><numericDomain><numberType>real</numberType></numericDomain></ratio></measurementScale></attribute><attribute id="d31mSNINDZNoH1MwdO0yNo3vI9lHen"><attributeName>EPT_Abund</attributeName><attributeDefinition>sum of individuals of EPT taxa</attributeDefinition><measurementScale><ratio><unit><standardUnit>dimensionless</standardUnit></unit><numericDomain><numberType>real</numberType></numericDomain></ratio></measurementScale></attribute><attribute id="1aiL785oFtKkVBqJEFKETwDv2H7alr"><attributeName>insect_SppRich</attributeName><attributeDefinition>number of insect taxa</attributeDefinition><measurementScale><ratio><unit><standardUnit>dimensionless</standardUnit></unit><numericDomain><numberType>real</numberType></numericDomain></ratio></measurementScale></attribute><attribute id="DNvvsKbnqOXTZihAvlaLS5rfX5y6WT"><attributeName>insect_Abund</attributeName><attributeDefinition>sum of individuals of insect taxa</attributeDefinition><measurementScale><ratio><unit><standardUnit>dimensionless</standardUnit></unit><numericDomain><numberType>real</numberType></numericDomain></ratio></measurementScale></attribute><attribute id="Tc1UnHIqfAGIxQO20SBx99znC155Cb"><attributeName>ppt_mm_12moPrior</attributeName><attributeDefinition>precipitation (mm) across the sampling duration, year was considered as the 12 month periods preceding the average month of sampling (e.g. for a site with most sampling occurring in May, year was defined as the proceeding May until April)</attributeDefinition><measurementScale><ratio><unit><standardUnit>millimeter<